[Unit]
Description=Kindred WebSocket Server (port 8002)
After=network.target

[Service]
Type=simple
User=kindred
Group=kindred
WorkingDirectory=/opt/kindred
EnvironmentFile=/opt/kindred/.env
Environment=KINDRED_WORKER_ROLE=websocket
Environment=KINDRED_REDIS_REQUIRED=true
ExecStart=/opt/kindred/.venv/bin/uvicorn app.ws_app:ws_app --host 127.0.0.1 --port 8002 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kindred-ws

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/kindred/kindred.db /opt/kindred/kindred.db-wal /opt/kindred/kindred.db-shm /opt/kindred/uploads /opt/kindred/backups /opt/kindred/.jwt_secret
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
