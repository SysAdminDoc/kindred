[Unit]
Description=Kindred Background Job Workers
After=network.target

[Service]
Type=simple
User=kindred
Group=kindred
WorkingDirectory=/opt/kindred
EnvironmentFile=/opt/kindred/.env
Environment=KINDRED_WORKER_ROLE=jobs
Environment=KINDRED_QUEUE_ENABLED=true
Environment=KINDRED_QUEUE_REQUIRED=true
ExecStart=/opt/kindred/.venv/bin/dramatiq --processes 2 --threads 2 app.tasks
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kindred-worker

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/kindred/kindred.db /opt/kindred/kindred.db-wal /opt/kindred/kindred.db-shm /opt/kindred/uploads /opt/kindred/backups /opt/kindred/.jwt_secret
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
