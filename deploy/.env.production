# =============================================================================
# Kindred Production Configuration
# =============================================================================
# 1. Copy this file to /opt/kindred/.env (or project root)
# 2. Fill in every value marked REQUIRED
# 3. Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- REQUIRED: Change these before first launch ---

# JWT signing key (generate a random string, 48+ chars)
KINDRED_JWT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS

# Admin credentials (change IMMEDIATELY after first login)
KINDRED_ADMIN_EMAIL=admin@yourdomain.com
KINDRED_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Your domain (used for CORS)
KINDRED_CORS_ORIGINS=https://yourdomain.com

# --- REQUIRED: Email (pick one provider) ---

# Option A: Resend (free 100/day) - https://resend.com
# KINDRED_SMTP_HOST=smtp.resend.com
# KINDRED_SMTP_PORT=587
# KINDRED_SMTP_USER=resend
# KINDRED_SMTP_PASSWORD=re_YOUR_API_KEY
# KINDRED_SMTP_FROM=noreply@yourdomain.com

# Option B: Brevo (free 300/day) - https://brevo.com
# KINDRED_SMTP_HOST=smtp-relay.brevo.com
# KINDRED_SMTP_PORT=587
# KINDRED_SMTP_USER=your-brevo-email
# KINDRED_SMTP_PASSWORD=your-smtp-key
# KINDRED_SMTP_FROM=noreply@yourdomain.com

# Option C: Gmail (free, limited)
# KINDRED_SMTP_HOST=smtp.gmail.com
# KINDRED_SMTP_PORT=587
# KINDRED_SMTP_USER=youremail@gmail.com
# KINDRED_SMTP_PASSWORD=your-app-password
# KINDRED_SMTP_FROM=youremail@gmail.com

# --- REQUIRED: Web Push (generate with: python deploy/gen-vapid-keys.py) ---
KINDRED_VAPID_PUBLIC_KEY=
KINDRED_VAPID_PRIVATE_KEY=
KINDRED_VAPID_CONTACT=mailto:admin@yourdomain.com

# --- Server (no need to change for standard setup) ---
KINDRED_HOST=0.0.0.0
KINDRED_USER_PORT=8000
KINDRED_ADMIN_PORT=8001

# --- Security ---
KINDRED_BCRYPT_ROUNDS=12
KINDRED_JWT_EXPIRE_HOURS=24
KINDRED_REFRESH_TOKEN_DAYS=14
KINDRED_RATE_LIMIT=60/minute
KINDRED_RATE_LIMIT_AUTH=10/minute
KINDRED_MAX_UPLOAD_MB=30

# --- REQUIRED: S3-compatible media storage ---
# New photos, videos, voice messages, selfies, stories, and event media are
# written here. Existing local uploads remain readable during migration.
KINDRED_OBJECT_STORAGE_ENDPOINT=https://s3.example.com
KINDRED_OBJECT_STORAGE_BUCKET=kindred-media
KINDRED_OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
KINDRED_OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_SECRET_KEY
KINDRED_OBJECT_STORAGE_REGION=us-east-1
KINDRED_OBJECT_STORAGE_PREFIX=media
KINDRED_OBJECT_STORAGE_PUBLIC_URL=
KINDRED_OBJECT_STORAGE_REQUIRED=true
KINDRED_OBJECT_STORAGE_ADDRESSING_STYLE=path

# --- Photo safety ---
KINDRED_PHOTO_HASH_ENABLED=true
KINDRED_PHOTO_HASH_MAX_DISTANCE=5
KINDRED_PHOTO_DHASH_MAX_DISTANCE=8
KINDRED_PHOTO_SAFETY_REQUIRED=true
KINDRED_PHOTODNA_ENABLED=false
# Enable only after qualified onboarding and a provider-specific adapter is ready.
KINDRED_PHOTODNA_HOOK_URL=
KINDRED_PHOTODNA_API_KEY=
KINDRED_PHOTODNA_TIMEOUT_SECONDS=3

# --- Sliding-window harassment detection ---
KINDRED_HARASSMENT_ENABLED=true
KINDRED_HARASSMENT_WINDOW_MINUTES=10
KINDRED_HARASSMENT_WARN_SCORE=2
KINDRED_HARASSMENT_MUTE_SCORE=4
KINDRED_HARASSMENT_MUTE_MINUTES=60
KINDRED_REPORT_COOLING_OFF_DAYS=30

# Optional ticketed-event payments. Keep disabled until Stripe keys and webhook are configured.
KINDRED_STRIPE_ENABLED=false
KINDRED_STRIPE_SECRET_KEY=
KINDRED_STRIPE_PUBLISHABLE_KEY=
KINDRED_STRIPE_WEBHOOK_SECRET=
KINDRED_EVENT_PAYMENT_HOLD_MINUTES=30

# --- Local ML selfie liveness ---
KINDRED_SELFIE_LIVENESS_ENABLED=true
KINDRED_SELFIE_LIVENESS_REQUIRED=true
KINDRED_SELFIE_LIVENESS_MODEL_PATH=/app/models/face_landmarker.task
KINDRED_SELFIE_LIVENESS_MODEL_SHA256=64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff
KINDRED_SELFIE_LIVENESS_MIN_FRAMES=8
KINDRED_SELFIE_LIVENESS_MAX_FRAMES=24
KINDRED_SELFIE_LIVENESS_FRAME_INTERVAL_MS=150
KINDRED_SELFIE_LIVENESS_MIN_DURATION_MS=900

# --- Shared worker coordination (required by the split production services) ---
# Bare metal: run Redis locally or point this at a protected Redis instance.
# Docker Compose overrides the URL with its internal kindred-redis service.
KINDRED_REDIS_URL=redis://127.0.0.1:6379/0
KINDRED_REDIS_REQUIRED=true
KINDRED_REDIS_KEY_PREFIX=kindred
KINDRED_QUEUE_ENABLED=true
KINDRED_QUEUE_REQUIRED=true
KINDRED_QUEUE_PROCESSES=2
KINDRED_QUEUE_THREADS=2

# --- Logging ---
KINDRED_LOG_LEVEL=WARNING
KINDRED_LOG_FORMAT=json

# --- Features ---
KINDRED_CONTENT_FILTER=true
KINDRED_PREMIUM_ENABLED=false
KINDRED_WEBHOOKS_ENABLED=false
KINDRED_DAILY_SUGGESTIONS=5
KINDRED_LOCATION_RADIUS_KM=100
KINDRED_STORY_EXPIRY_HOURS=24
KINDRED_MATCH_EXPIRY_DAYS=7
KINDRED_BLIND_DATE_HOURS=48
KINDRED_MESSAGE_COOLDOWN_MINUTES=5
KINDRED_MESSAGE_COOLDOWN_COUNT=10
KINDRED_UNDO_BLOCK_MINUTES=5
KINDRED_SAFETY_CHECKIN_MINUTES=60
KINDRED_DEFAULT_LOCALE=en
KINDRED_DEFAULT_THEME=mocha
KINDRED_PHOTO_REVEAL_THRESHOLD=60.0

# --- Backups ---
KINDRED_BACKUP_DIR=./backups
KINDRED_BACKUP_KEEP_COUNT=14
KINDRED_BACKUP_INTERVAL_HOURS=12

# --- Database Maintenance ---
KINDRED_VACUUM_INTERVAL_HOURS=168
