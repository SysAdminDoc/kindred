# Kindred Configuration
# Copy to .env and customize

# JWT secret - CHANGE THIS in production (auto-generated if not set)
# KINDRED_JWT_SECRET=your-secret-key-here

# JWT token expiry in hours
# KINDRED_JWT_EXPIRE_HOURS=72

# Default admin credentials
# KINDRED_ADMIN_EMAIL=admin@kindred.local
# KINDRED_ADMIN_PASSWORD=admin

# Server
# KINDRED_HOST=127.0.0.1
# KINDRED_USER_PORT=8000
# KINDRED_ADMIN_PORT=8001
# KINDRED_CORS_ORIGINS=*

# Database
# KINDRED_DB_PATH=./kindred.db

# Uploads
# KINDRED_UPLOAD_DIR=./uploads
# KINDRED_MAX_UPLOAD_MB=30

# S3-compatible media storage (leave the bucket unset for local development)
# KINDRED_OBJECT_STORAGE_ENDPOINT=https://s3.example.com
# KINDRED_OBJECT_STORAGE_BUCKET=kindred-media
# KINDRED_OBJECT_STORAGE_ACCESS_KEY=
# KINDRED_OBJECT_STORAGE_SECRET_KEY=
# KINDRED_OBJECT_STORAGE_REGION=us-east-1
# KINDRED_OBJECT_STORAGE_PREFIX=media
# KINDRED_OBJECT_STORAGE_PUBLIC_URL=
# KINDRED_OBJECT_STORAGE_REQUIRED=false
# KINDRED_OBJECT_STORAGE_ADDRESSING_STYLE=path

# Upload-time perceptual-hash safety (the local corpus is hash-only)
# KINDRED_PHOTO_HASH_ENABLED=true
# KINDRED_PHOTO_HASH_MAX_DISTANCE=5
# KINDRED_PHOTO_DHASH_MAX_DISTANCE=8
# KINDRED_PHOTO_SAFETY_REQUIRED=false
# KINDRED_PHOTODNA_ENABLED=false
# KINDRED_PHOTODNA_HOOK_URL=
# KINDRED_PHOTODNA_API_KEY=
# KINDRED_PHOTODNA_TIMEOUT_SECONDS=3

# Sliding-window direct-message harassment detection
# KINDRED_HARASSMENT_ENABLED=true
# KINDRED_HARASSMENT_WINDOW_MINUTES=10
# KINDRED_HARASSMENT_WARN_SCORE=2
# KINDRED_HARASSMENT_MUTE_SCORE=4
# KINDRED_HARASSMENT_MUTE_MINUTES=60

# Local ML selfie liveness (blink + head turn over an ordered image sequence)
# The pinned MediaPipe Face Landmarker asset is included at models/face_landmarker.task.
# KINDRED_SELFIE_LIVENESS_ENABLED=true
# KINDRED_SELFIE_LIVENESS_REQUIRED=true
# KINDRED_SELFIE_LIVENESS_MODEL_PATH=./models/face_landmarker.task
# KINDRED_SELFIE_LIVENESS_MODEL_SHA256=64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff
# KINDRED_SELFIE_LIVENESS_MIN_FRAMES=8
# KINDRED_SELFIE_LIVENESS_MAX_FRAMES=24
# KINDRED_SELFIE_LIVENESS_FRAME_INTERVAL_MS=150
# KINDRED_SELFIE_LIVENESS_MIN_DURATION_MS=900
# KINDRED_SELFIE_LIVENESS_BLINK_CLOSED_EAR=0.20
# KINDRED_SELFIE_LIVENESS_BLINK_OPEN_EAR=0.24
# KINDRED_SELFIE_LIVENESS_HEAD_TURN_DELTA=0.12

# Rate limiting
# KINDRED_RATE_LIMIT=60/minute
# KINDRED_RATE_LIMIT_AUTH=10/minute
# KINDRED_REDIS_URL=redis://localhost:6379/0
# KINDRED_REDIS_REQUIRED=false
# KINDRED_REDIS_KEY_PREFIX=kindred

# Production process topology (used by deploy/docker-compose.prod.yml)
# KINDRED_USER_WORKERS=2
# KINDRED_ADMIN_WORKERS=1
# KINDRED_WS_WORKERS=2
# KINDRED_QUEUE_ENABLED=false
# KINDRED_QUEUE_REQUIRED=false
# KINDRED_QUEUE_PROCESSES=2
# KINDRED_QUEUE_THREADS=2

# Photo reveal threshold
# KINDRED_PHOTO_REVEAL_THRESHOLD=60.0

# Logging
KINDRED_LOG_LEVEL=INFO
KINDRED_LOG_FORMAT=json

# Email (configure for production)
# KINDRED_SMTP_HOST=smtp.example.com
# KINDRED_SMTP_PORT=587
# KINDRED_SMTP_USER=
# KINDRED_SMTP_PASSWORD=
# KINDRED_SMTP_FROM=noreply@kindred.app

# Security
KINDRED_BCRYPT_ROUNDS=12
KINDRED_REFRESH_TOKEN_DAYS=30

# Semantic embeddings. MPNet is the default quality model; MiniLM is the
# lightweight fallback when the preferred model cannot be loaded.
# KINDRED_EMBEDDING_MODEL=all-mpnet-base-v2
# KINDRED_EMBEDDING_FALLBACK_MODEL=all-MiniLM-L6-v2

# Web Push (VAPID) - generate at https://vapidkeys.com
# KINDRED_VAPID_PUBLIC_KEY=
# KINDRED_VAPID_PRIVATE_KEY=
# KINDRED_VAPID_CONTACT=mailto:admin@kindred.app

# Content Filtering
KINDRED_CONTENT_FILTER=true

# Premium features
KINDRED_PREMIUM_ENABLED=false

# Daily match suggestions count
KINDRED_DAILY_SUGGESTIONS=5

# Location matching
KINDRED_LOCATION_RADIUS_KM=100

# Stories
KINDRED_STORY_EXPIRY_HOURS=24

# Match expiry (days without messaging)
KINDRED_MATCH_EXPIRY_DAYS=7

# Database backups
KINDRED_BACKUP_DIR=./backups
KINDRED_BACKUP_KEEP_COUNT=7
KINDRED_BACKUP_INTERVAL_HOURS=24

# Internationalization
KINDRED_DEFAULT_LOCALE=en

# Blind Date (hours before photo/name reveal)
# KINDRED_BLIND_DATE_HOURS=48

# Message Cooldown (rate limit for new matches)
# KINDRED_MESSAGE_COOLDOWN_MINUTES=5
# KINDRED_MESSAGE_COOLDOWN_COUNT=10

# Undo Block (grace period in minutes)
# KINDRED_UNDO_BLOCK_MINUTES=5

# Safety Check-in (default timer in minutes)
# KINDRED_SAFETY_CHECKIN_MINUTES=60

# Database Vacuum (hours between auto-vacuum)
# KINDRED_VACUUM_INTERVAL_HOURS=168

# Webhooks
# KINDRED_WEBHOOKS_ENABLED=false

# Theme (mocha or latte)
# KINDRED_DEFAULT_THEME=mocha
